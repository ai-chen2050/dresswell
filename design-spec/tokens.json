{
  "meta": {
    "project": "穿好衣",
    "viewport": [390, 844],
    "source": "design-spec/html/v1.html",
    "updated": "2026-09-02",
    "note": "唯一真相源。改设计从这里改，代码里的令牌文件是它的产物，勿手改。"
  },

  "semantic": {
    "success": "#2EBD85",
    "warning": "#F5A524",
    "danger": "#FF5A5F",
    "info": "#5B8DEF"
  },

  "scale": {
    "largeTextScale": 1.18,
    "minTapTarget": 44
  },

  "type": {
    "pageTitle": { "size": 25, "weight": 800, "letterSpacing": 0.5 },
    "pageSubtitle": { "size": 12, "weight": 600 },
    "cardTitle": { "size": 16, "weight": 800 },
    "sectionTitle": { "size": 14, "weight": 800 },
    "body": { "size": 13.5, "weight": 600 },
    "sub": { "size": 12.5, "weight": 500 },
    "hint": { "size": 11, "weight": 500 },
    "weak": { "size": 10.5, "weight": 500 },
    "numberXL": { "size": 32, "weight": 800, "letterSpacing": -0.5 },
    "numberL": { "size": 22, "weight": 800 },
    "cta": { "size": 15, "weight": 800 }
  },

  "space": {
    "page": 16,
    "header": 20,
    "cardPad": 16,
    "cardPadSmall": 13,
    "cardGap": 11,
    "inline": 8,
    "tile": 7
  },

  "size": {
    "ctaHeight": 50,
    "iconButton": 38,
    "tile": 56,
    "fabHeight": 48,
    "avatar": 52
  },

  "radius": {
    "card": 20,
    "cta": 15,
    "tile": 13,
    "chip": 12,
    "pill": 999
  },

  "motion": {
    "cardEnter": { "duration": 250, "curve": "easeOutCubic", "slideY": 0.06, "staggerMs": 70 },
    "tileEnter": { "duration": 220, "curve": "easeOutBack", "staggerMs": 40, "scaleFrom": 0.85 },
    "numberTween": { "duration": 650, "curve": "easeOutCubic" },
    "expand": { "duration": 260, "curve": "easeOutCubic" }
  },

  "themes": {
    "default": {
      "light": {
        "bg": "#F4F6F5",
        "card": "#FFFFFF",
        "surface": "#F0F3F1",
        "border": "#E6EBE8",
        "text": {
          "primary": "#172821",
          "body": "#2A3B34",
          "sub": "#7A8B84",
          "weak": "#96A49D",
          "disabled": "#B4C0BA"
        },
        "brand": "#2EBD85",
        "brandGradient": ["#2EBD85", "#1B9E86"],
        "shadow": {
          "card": { "x": 0, "y": 4, "blur": 16, "color": "rgba(26,43,36,0.06)" },
          "cta": { "x": 0, "y": 8, "blur": 20, "color": "rgba(46,189,133,0.32)" }
        }
      },
      "dark": {
        "bg": "#121418",
        "card": "#1E2228",
        "surface": "#2A2F36",
        "border": "#3A4048",
        "text": {
          "primary": "#F2F3F2",
          "body": "#D9DEDB",
          "sub": "#8C9A93",
          "weak": "#6B7873",
          "disabled": "#4C5551"
        },
        "brand": "#4ED4A2",
        "brandGradient": ["#1F8A64", "#166F60"],
        "shadow": {
          "card": { "x": 0, "y": 0, "blur": 0, "color": "rgba(0,0,0,0)" },
          "cta": { "x": 0, "y": 6, "blur": 16, "color": "rgba(0,0,0,0.35)" }
        }
      }
    }
  }
}
